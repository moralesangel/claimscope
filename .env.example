# Copy to .env and fill in. Never commit .env.

# API key for the provider you select below. Only that one is required.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Which backend the LLM nodes use: "anthropic" (default) or "google".
CLAIMSCOPE_PROVIDER=anthropic

# Model id. Leave empty to use the provider's default
# (anthropic -> claude-sonnet-5, google -> gemini-3.6-flash).
CLAIMSCOPE_MODEL_NAME=

# Budget and triage limits.
CLAIMSCOPE_MAX_CLAIMS=2
CLAIMSCOPE_BUDGET_MINUTES_TOTAL=60
CLAIMSCOPE_SEEDS_PER_ARM=3
CLAIMSCOPE_MAX_DEBUG_ATTEMPTS=3

# Sandbox limits.
CLAIMSCOPE_DOCKER_IMAGE=claimscope-cpu:latest
CLAIMSCOPE_SANDBOX_CPUS=2
CLAIMSCOPE_SANDBOX_MEMORY_MB=4096
CLAIMSCOPE_SANDBOX_TIMEOUT_S=1800

# Optional tracing (Langfuse or LangSmith). The app must work with this off.
CLAIMSCOPE_TRACING_ENABLED=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=
